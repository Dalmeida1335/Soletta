<div class="soletta{% if section.settings.dark %} sol-dark{% endif %}">
  <div class="sol-wrap sol-wrap--read" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {%- for block in section.blocks -%}
      <div class="sol-chapter sol-reveal" {{ block.shopify_attributes }}>
        <div class="sol-chapter__rail">
          {%- if block.settings.label != blank -%}
            <p class="sol-num">{{ block.settings.label | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        <div class="sol-chapter__body">
          {{ block.settings.body }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Soletta story",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 88 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "Palermo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A drink sold on the street" },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>In Palermo, traveling vendors sold seltz limone e sale from carts on the corner. Lemon squeezed to order, a pinch of sea salt, water charged with gas. You drank it standing up, in the heat, and kept moving.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Soletta story",
      "blocks": [{ "type": "chapter" }, { "type": "chapter" }]
    }
  ]
}
{% endschema %}
